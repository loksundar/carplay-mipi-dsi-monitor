# Copy to config.env (git-ignored) and adjust. Sourced by build.sh, flash.sh, remote_flash.sh, mac/deploy_vdclient.sh.
MAC_IP=192.168.1.50            # this Mac's WiFi address (must match SERVER in overlay/etc/dashboard.conf)
BOARD_IP=192.168.1.60          # the screen's WiFi address (router DHCP)
XFEL=xfel                      # path to xfel (https://github.com/xboot/xfel)
BACKUP_IMAGE=$HOME/v831_backup/flash_full_16MB.bin   # your own full flash dump; read-only input to build.sh / flash.sh restore
